<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Page Not Found' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<header class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="brand">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="brand-icon"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/></svg>
      <span class="brand-name">REV<span class="accent">ENGINE</span></span>
    </a>
  </div>
</header>

<div class="error-state">
  <div class="empty-state-icon" style="width:56px;height:56px;margin-bottom:1.25rem;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></div>
  <h1 style="font-family:var(--font-display); font-size:1.75rem; margin:0 0 0.5rem;"><%= title || 'Page Not Found' %></h1>
  <p class="muted" style="max-width:420px; margin:0 0 1.5rem;">This page doesn't exist, or the car/manufacturer you're looking for isn't in the catalog.</p>
  <a href="/cars" class="btn btn-primary">Browse all cars</a>
</div>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
